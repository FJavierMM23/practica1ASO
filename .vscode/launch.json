{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ejecutar",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/boot/boot",
      "args": [
        "${workspaceFolder}/minikernel/kernel"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "make build",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Ignorar SIGUSR1 en el depurador",
          "text": "-interpreter-exec console \"handle SIGUSR1 nostop noprint pass\"",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/javi/Documentos/ASO/Practica1/minikernel/minikernel",
      "program": "/home/javi/Documentos/ASO/Practica1/minikernel/minikernel/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}